# Amnesia configuration template.
#
# Copy this file to `.env` (git-ignored) or into `~/.amnesia/.env` and edit.
# Precedence, lowest to highest:
#     built-in defaults -> ~/.amnesia/config.json -> environment -> CLI flags
# Only the variables you actually set are applied; everything else keeps its
# default. Boolean values accept 1/0, true/false, yes/no, on/off.

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Directory that holds the SQLite memory store and config.json.
# Default: ~/.amnesia  (Windows: C:\Users\<you>\.amnesia)
# AMNESIA_HOME=C:\Users\you\.amnesia

# Full path to the SQLite file. Default: <AMNESIA_HOME>/amnesia.db
# AMNESIA_DB=C:\Users\you\.amnesia\amnesia.db

# ---------------------------------------------------------------------------
# Ollama
# ---------------------------------------------------------------------------

# Base URL of the Ollama daemon that serves the models.
# Default: http://127.0.0.1:11434
# AMNESIA_OLLAMA_URL=http://127.0.0.1:11434

# Default chat model. When unset, Amnesia picks the first non-embedding model
# installed in Ollama. Fully qualified names work too:
#   R4C3R/qwen2.5-coder-7b-instruct-heretic:q4_k_m
# AMNESIA_MODEL=dolphin3:latest

# Embedding model used for semantic recall. Default: nomic-embed-text
# Set to "none" or "off" to disable embeddings (keyword-only retrieval).
# AMNESIA_EMBED_MODEL=nomic-embed-text

# Model used for automatic fact/event distillation. Default: the chat model.
# AMNESIA_EXTRACTION_MODEL=dolphin3:latest

# ---------------------------------------------------------------------------
# Proxy / HTTP API
# ---------------------------------------------------------------------------

# Interface and port for `amnesia serve`. Default: 127.0.0.1 / 11435
# Leave the Ollama daemon itself on 11434; the proxy is a separate listener.
# AMNESIA_PROXY_HOST=127.0.0.1
# AMNESIA_PROXY_PORT=11435

# Optional bearer token. When set, every /amnesia/* API route except
# /amnesia/health requires `Authorization: Bearer <token>` or
# `X-Amnesia-Token: <token>`. Passthrough chat routes stay open (local use).
# AMNESIA_API_TOKEN=

# Upstream request timeout in seconds (local models on CPU can be slow).
# Default: 600
# AMNESIA_REQUEST_TIMEOUT=600

# ---------------------------------------------------------------------------
# Memory behaviour
# ---------------------------------------------------------------------------

# Master switch: remember and inject memory. Default: true
# AMNESIA_MEMORY_ENABLED=true

# Inject the <amnesia_memory> block into model prompts. Default: true
# AMNESIA_INJECT_CONTEXT=true

# Automatically extract durable facts and activity from conversations.
# Default: true
# AMNESIA_EXTRACTION=true

# Distil a session summary when a session ends. Default: true
# AMNESIA_SUMMARIZATION=true

# Turns between automatic extractions. Default: 4
# AMNESIA_EXTRACTION_EVERY=4

# Minimum combined text length before an exchange is worth extracting.
# Default: 40
# AMNESIA_EXTRACTION_MIN_CHARS=40

# Redact API keys, tokens, passwords and private keys before storing text.
# Strongly recommended. Default: true
# AMNESIA_REDACT=true

# Model context window used for budget planning. Default: 8192
# AMNESIA_CONTEXT_WINDOW=8192

# Tokens reserved for the injected memory block. Default: 1200
# AMNESIA_MEMORY_BUDGET=1200

# Tokens reserved for the always-included identity profile. Default: 350
# AMNESIA_PROFILE_BUDGET=350

# Recent conversation turns replayed into the prompt. Default: 6
# AMNESIA_RECENT_TURNS=6

# Minutes of inactivity before a new session starts automatically.
# Default: 45
# AMNESIA_SESSION_GAP=45

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# DEBUG, INFO, WARNING, ERROR. Default: INFO
# AMNESIA_LOG_LEVEL=INFO

# IANA timezone (for example Europe/Paris) or empty for the system timezone.
# Timestamps are always stored in UTC; this only affects rendering.
# AMNESIA_TIMEZONE=
